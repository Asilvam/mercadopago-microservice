# Configuracion complementaria, compartida por reservas y mensualidades.
# Valores activos sugeridos para local; configurar los valores Prod en Heroku.
# Reutilizar credenciales existentes. Todos los secretos de esta plantilla son placeholders.

# Razon: autenticar las consultas y preferencias ante Mercado Pago.
# Local: token existente del piloto; su cuenta y modo se verifican con el proveedor.
# Prod: token vigente de la cuenta real del club, conservado como secreto en Heroku.
MP_ACCESS_TOKEN=replace-with-the-existing-mercadopago-token

# Razon: verificar que las notificaciones recibidas tengan una firma valida.
# Local: secreto de firma de la integracion usada en el piloto y su webhook publico.
# Prod: secreto existente de la integracion de Mercado Pago del club.
MP_WEBHOOK_SECRET=replace-with-the-existing-webhook-secret

# Razon: autenticar preferencias, consultas y callbacks internos con el backend.
# Local: misma INTERNAL_API_KEY del backend local; conservar la existente.
# Prod: misma INTERNAL_API_KEY del backend en Heroku; conservar la existente.
INTERNAL_API_KEY=replace-with-the-existing-key-shared-with-backend

# Razon: backend que recibe las confirmaciones de reservas y mensualidades.
# Local: http://localhost:3500
# Prod: https://app-tenis-qtro-backend-2-dc5629e092b9.herokuapp.com
BACKEND_URL=http://localhost:3500

# Razon: endpoint publico donde Mercado Pago notifica los cambios de un pago.
# Local: https://<host-publico-del-piloto>/mercadopago/webhook, dirigido a este microservicio.
# Prod: https://mercadopago-service-ctq-2-9c4551b6f8ba.herokuapp.com/mercadopago/webhook
# El host example.com no funciona para cobrar: sustituirlo y verificar firma y entrega.
NOTIFICATION_URL=https://mp-pruebas.example.com/mercadopago/webhook

# Razon: retorno de una reserva aprobada y dominio del retorno de mensualidades.
# Local: http://localhost:5173/payment/success
# Prod: https://ctq.serviciosasm.cl/payment/success
# Mensualidades reutiliza este dominio con /monthlypayments/return y reference.
# Reservas: el codigo agrega reservation=<id> a los tres retornos; no agregarlo aqui.
# El frontend verifica en backend; estas URLs no acreditan un pago aprobado/rechazado.
# Aplicado en Heroku el 2026-10-29; no modifica preferencias ya emitidas.
MP_SUCCESS_URL=http://localhost:5173/payment/success

# Razon: retorno del checkout de reservas cuando el pago no se aprueba.
# Local: http://localhost:5173/payment/failure
# Prod: https://ctq.serviciosasm.cl/payment/failure
MP_FAILURE_URL=http://localhost:5173/payment/failure

# Razon: retorno del checkout de reservas cuando el pago sigue pendiente.
# Local: http://localhost:5173/payment/pending
# Prod: https://ctq.serviciosasm.cl/payment/pending
MP_PENDING_URL=http://localhost:5173/payment/pending

# Mensualidades reutiliza estas credenciales y URLs, sin variables adicionales.
# Cuenta: /users/me. Modo: evidencia de la preferencia del proveedor, no prefijo del token.
# TEST en BD es tarifa: un pago real de $180/$50 sigue siendo dinero real.
# El resto de la configuracion del servicio se conserva en su entorno existente.
# Nunca iniciar un worker de prueba contra la base de eventos de produccion.
