NODE_ENV=development
PORT=3000

MP_ACCESS_TOKEN=APP_USR-replace-me
MP_WEBHOOK_SECRET=replace-with-the-secret-signature-from-mercado-pago
INTERNAL_API_KEY=replace-with-the-same-long-random-secret-used-by-the-backend
MP_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
MP_SUCCESS_URL=https://example.com/payment/success
MP_FAILURE_URL=https://example.com/payment/failure
MP_PENDING_URL=https://example.com/payment/pending
NOTIFICATION_URL=https://example.herokuapp.com/mercadopago/webhook

BACKEND_URL=https://backend.example.com
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/payments

AUDIT_LOG_RETENTION_DAYS=365
WEBHOOK_INBOX_RETENTION_DAYS=30
WEBHOOK_EFFECT_RETENTION_DAYS=365
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_RETRY_BASE_MS=5000
WEBHOOK_RETRY_MAX_MS=900000
WEBHOOK_LOCK_TIMEOUT_MS=120000
WEBHOOK_POLL_INTERVAL_MS=5000
