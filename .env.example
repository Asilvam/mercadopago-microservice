AUDIT_LOG_RETENTION_DAYS=365
BACKEND_URL=https://backend.example.com
FRONTEND_URL=https://frontend.example.com
INTERNAL_API_KEY=replace-with-the-same-long-random-secret-used-by-the-backend
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/payments
MP_ACCESS_TOKEN=APP_USR-replace-me
MP_FAILURE_URL=https://example.com/payment/failure
MP_PENDING_URL=https://example.com/payment/pending
MP_SUCCESS_URL=https://example.com/payment/success
